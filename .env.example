# CLIP Node — Environment Configuration
# Copy this file to .env and edit before running.

# ─── Node Identity ────────────────────────────────────────────────────────────

# The routing host placed in CLIP URIs. The authority fingerprint is derived
# from PRIVATE_KEY_FILE, producing clip://{NODE_DOMAIN}/{fingerprint}/{uuid4}.
# For production: NODE_DOMAIN=products.acme.com
# For development: NODE_DOMAIN=localhost:8000
NODE_DOMAIN=localhost:8000

# The externally reachable base URL of this node's API.
# Other nodes and clients will contact this URL during resolution.
# For production: NODE_API_BASE=https://api.acme.com
NODE_API_BASE=http://localhost:8000

# ─── Storage ──────────────────────────────────────────────────────────────────

# SQLAlchemy async database URL.
# Development (SQLite):   DATABASE_URL=sqlite+aiosqlite:///./clip_node.db
# Production (PostgreSQL): DATABASE_URL=postgresql+asyncpg://user:pass@localhost/clip
DATABASE_URL=sqlite+aiosqlite:///./clip_node.db

# Path to the Ed25519 private key file (32 bytes, binary).
# Generated automatically on first run. KEEP THIS SECRET.
PRIVATE_KEY_FILE=./node_private_key.bin

# ─── Authentication ───────────────────────────────────────────────────────────

# API key required for record and relationship write operations.
# Change this before deployment. Consider replacing with JWT or mTLS for production.
API_KEY=change-me-before-deployment

# ─── Federation ───────────────────────────────────────────────────────────────

# Timeout (seconds) for outbound HTTP calls to other nodes.
FEDERATION_TIMEOUT=10

# Development only: permit HTTP discovery for private/service DNS names.
# Keep false when routing hosts are publicly reachable.
ALLOW_INSECURE_HTTP_DISCOVERY=false

# How long (seconds) to reuse a cached remote record before re-fetching.
# Set to 0 to always re-fetch from the authority node.
CACHE_TTL=3600

# DID-authenticated CLIP peer discovery.
CLIP_GOSSIP_ENABLED=true
CLIP_GOSSIP_SEEDS=
CLIP_GOSSIP_INTERVAL=15
CLIP_GOSSIP_SUSPECT_TIMEOUT=45
CLIP_GOSSIP_DEAD_TIMEOUT=120

# Authority role and proof verification method owner.
NODE_ROLE=resolver
DID_WEB_ID=did:web:localhost%3A8000
DID_VERIFICATION_METHOD=did:web:localhost%3A8000#authority-key
CLIP_TRUSTED_PUBLISHERS=
CLIP_EGRESS_ALLOWED_HOSTS=
CLIP_MAX_SERVICE_BYTES=33554432
CLIP_ALLOW_HTTP_LOOPBACK=false
